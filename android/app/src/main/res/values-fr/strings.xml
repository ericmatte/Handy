    <string name="transcription_custom_words">Mots personnalisés</string>
    <string name="transcription_custom_words_hint">Noms et jargon que le modèle écrit mal. Les mots proches dans la transcription sont remplacés par ces orthographes, comme sur ordinateur (ex. « Charge B » → « ChargeBee »).</string>
    <string name="transcription_custom_words_placeholder">ex. Handy, ChargeBee</string>
    <string name="transcription_threshold">Tolérance : %1$.2f</string>
    <string name="transcription_threshold_hint">Plus haut remplace plus agressivement. Valeur par défaut sur ordinateur : %1$.2f.</string>
