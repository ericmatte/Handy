    <string name="transcription_translate_unsupported">Not available with %1$s (use Whisper Small/Base or Canary).</string>
    <string name="transcription_custom_words">Custom words</string>
    <string name="transcription_custom_words_hint">Names and jargon the model gets wrong. Close matches in the transcript are replaced by these spellings, like on desktop (e.g. \"Charge B\" → \"ChargeBee\").</string>
    <string name="transcription_custom_words_placeholder">e.g. Handy, ChargeBee</string>
    <string name="transcription_threshold">Matching tolerance: %1$.2f</string>
    <string name="transcription_threshold_hint">Higher replaces more aggressively. Desktop default: %1$.2f.</string>
    <string name="transcription_fillers_title">Filler words</string>
    <string name="transcription_fillers">Remove filler words</string>
    <string name="transcription_fillers_hint">uh, hmm… always; um/ah (English), euh (French), äh (German) when the language is known. Repeated words (\"I I I\") are collapsed.</string>
    <string name="transcription_custom_fillers">Custom filler words</string>
    <string name="transcription_custom_fillers_hint">Comma-separated. Replaces the built-in lists; leave empty to use them.</string>
