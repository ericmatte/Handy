    <string name="settings_silence">Stop after silence: %1$.1f s</string>
    <string name="settings_silence_explanation">Recording stops by itself after this much silence following speech. You can also tap the button to stop.</string>
    <string name="settings_exclusions_title">Excluded apps</string>
    <string name="settings_exclusions_explanation">The button never appears in these apps. Banks and password managers found on this phone were added automatically. Handy itself, the system UI, the lock screen and launchers are always excluded.</string>
