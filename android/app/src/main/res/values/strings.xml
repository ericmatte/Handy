    <string name="app_name">Handy</string>
    <string name="accessibility_service_label">Handy dictation button</string>
    <string name="accessibility_service_description">Shows a small Handy button next to the text field you are typing in. Tap it to dictate: your voice is transcribed and the text is inserted at the cursor. Handy reads which field is focused (never password fields or excluded apps) and does not collect or send what you type.</string>

    <!-- Overlay -->
    <string name="overlay_button_description">Handy: tap to dictate, long-press for options</string>
    <string name="overlay_button_recording">Handy is listening. Tap to stop.</string>
    <string name="overlay_button_processing">Handy is transcribing</string>
    <string name="menu_hide_in_app">Hide in this app</string>
