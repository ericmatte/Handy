    <string name="language_auto">Automatic</string>
    <string name="transcription_language_title">Language</string>
    <string name="transcription_language">Spoken language</string>
    <string name="transcription_language_hint">Setting the language improves accuracy and lets Handy remove filler words of that language.</string>
    <string name="transcription_language_auto_hint">%1$s detects the language by itself.</string>
    <string name="transcription_language_fixed">%1$s only understands %2$s.</string>
    <string name="transcription_language_unsupported">%1$s doesn\'t support this language: %2$s is used instead.</string>
