    <string name="home_first_model_title">Download a speech model</string>
    <string name="home_first_model_body">Handy transcribes on the phone, like on desktop. Open Speech models and download one: Parakeet V3 is recommended (25 European languages including French).</string>

    <!-- Models -->
    <string name="models_intro">The same models as Handy desktop, running on the phone (sherpa-onnx). Download as many as you like and pick the one to use. Wi-Fi recommended; keep this screen open while downloading.</string>
